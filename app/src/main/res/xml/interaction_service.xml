<?xml version="1.0" encoding="utf-8"?>
<!--
    Voice Interaction Service configuration.
    This registers Aria as a valid Android Voice Interaction Service,
    allowing it to be selected as the default digital assistant in
    Settings → Apps → Default Apps → Digital Assistant App.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.bigwizard.aria.service.AriaVoiceInteractionService"
    android:recognitionService="com.bigwizard.aria.service.AriaVoiceInteractionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true"
    android:supportsLocalInteraction="true" />